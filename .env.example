# Copy to .env for local development. Never put actual keys in this template.
KIS_ENV=demo
# Optional existing file; only KIS_APP_KEY and KIS_APP_SECRET are read from it.
# KIS_ENV_FILE=../maria/.env

# Alternatively inject KIS_APP_KEY and KIS_APP_SECRET as process environment variables.
# A deployment can set them in its own .env; do not deploy the local Maria file reference.

# Required for calculations; use a verified actual exchange calendar.
# RISK_CALENDAR_PATH=data/krx-calendar.csv
# Optional separate verified daily hours: date,regular_close_at,available_at,source_ref
# RISK_TRADING_HOURS_PATH=config/krx-trading-hours.csv
# RISK_DB_PATH=data/risk.sqlite3
# RISK_UNIVERSE_PATH=config/universe.csv
